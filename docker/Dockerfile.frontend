# Образы запинены по digest; см. комментарий в docker/Dockerfile.admin.
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS builder
ARG VITE_SOURCEMAP=false
ENV VITE_SOURCEMAP=${VITE_SOURCEMAP} \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Версия pnpm берётся из поля packageManager в frontend/package.json: глобальная
# установка npm i -g pnpm больше не нужна, версия совпадает с локальной и CI.
RUN corepack enable
WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend ./
RUN pnpm build && \
    if [ "${VITE_SOURCEMAP}" = "false" ] && find dist -name '*.map' -print -quit | grep -q .; then \
        echo "unexpected sourcemaps in dist when VITE_SOURCEMAP=false" >&2; \
        exit 1; \
    fi

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runtime
COPY docker/nginx-headers.conf /etc/nginx/snippets/security-headers.conf
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
ENTRYPOINT ["nginx", "-g", "daemon off;"]
