# Образы запинены по digest; см. комментарий в docker/Dockerfile.admin.
FROM rust:1.100-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang cmake protobuf-compiler pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY backend ./backend
RUN cargo build --release --locked -p awg-worker

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 nftables kmod ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/awg-worker /usr/local/bin/awg-worker
ENTRYPOINT ["/usr/local/bin/awg-worker"]
