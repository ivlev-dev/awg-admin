{
  "name": "awg-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "type": "module",
  "scripts": {
    "arch:check": "depcruise src --config .dependency-cruiser.cjs --webpack-config .dependency-cruiser.webpack.cjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@ivlev-dev/silent": "0.13.1",
    "@ivlev-dev/silent-core": "0.13.1",
    "@ivlev-dev/silent-di": "0.13.1",
    "@ivlev-dev/silent-form": "0.13.1",
    "@ivlev-dev/silent-reactivity": "0.13.1",
    "@ivlev-dev/silent-router": "0.13.1",
    "@ivlev-dev/silent-validation": "0.13.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@ivlev-dev/silent-validation-vite": "0.13.1",
    "@ivlev-dev/silent-vite": "0.13.1",
    "@playwright/test": "1.65.1",
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.7.2",
    "happy-dom": "^20.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
