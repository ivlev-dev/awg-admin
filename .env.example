# Окружение: production | development
#
# docker-compose.yml подставляет production по умолчанию (fail-closed): без
# AWG_MASTER_KEY, AWG_JWT_SECRET и сменённого пароля admin (не admin12345)
# контейнер не стартует. Для локальной разработки раскомментируйте development
# ниже или используйте docker-compose.dev.yml.
#
# В production обязательны AWG_MASTER_KEY, AWG_JWT_SECRET (не короче 32 байт) и
# непустой AWG_ADMIN_PASSWORD, отличный от admin12345 (иначе старт завершается
# ошибкой).
AWG_ENV=production
# AWG_ENV=development

# Домен и TLS
# Домен, на который Traefik выпускает сертификат через ACME (Host(...) в роутерах)
AWG_DOMAIN=panel.localhost
TRAEFIK_ACME_EMAIL=

# Секреты
# openssl rand -base64 32
AWG_MASTER_KEY=
# openssl rand -base64 48; в production не короче 32 байт
AWG_JWT_SECRET=
# iss/aud JWT (по умолчанию awg-admin)
AWG_JWT_ISSUER=awg-admin
AWG_JWT_AUDIENCE=awg-admin
# TTL access-токена в секундах (по умолчанию 900) и refresh-токена (2592000).
# Refresh одноразовый: при /auth/refresh выдаётся новая пара, старая отзывается;
# /auth/logout и смена пароля отзывают все refresh-сессии.
AWG_ACCESS_TTL_SECS=900
AWG_REFRESH_TTL_SECS=2592000

# Первичный администратор
# Вход только по email: переменная AWG_ADMIN_LOGIN удалена.
AWG_ADMIN_EMAIL=admin@local
AWG_ADMIN_PASSWORD=admin12345

# Сеть/DNS
AWG_DNS=1.1.1.1,8.8.8.8
AWG_PUBLIC_URL=https://panel.localhost
# deep link подтверждения email для мобильного приложения (в письме добавляется {AWG_APP_VERIFY_URL}?token=...)
AWG_APP_VERIFY_URL=umbravpn://verify
AWG_CORS_ORIGINS=
# Доверенные reverse-proxy: IP/CIDR через запятую.
# X-Forwarded-For / X-Real-IP учитываются только если прямой peer входит
# в этот список; пусто — заголовки игнорируются (берётся адрес peer).
# docker-compose.yml задаёт подсеть сети web (172.30.0.0/24, см. networks.web)
# и подставляет её по умолчанию; при смене подсети обновите это значение.
# Локально без Traefik достаточно 127.0.0.1/32.
AWG_TRUSTED_PROXIES=172.30.0.0/24

# Rate limiting (sliding window)
# memory — счётчики в памяти процесса (по умолчанию);
# redb — общая таблица rate_limits, БД открывается в redb MultiWriter;
# нужен при нескольких репликах admin с общим AWG_DB_PATH
AWG_RATE_LIMIT_STORE=memory
# 0 отключает лимит; окно в секундах
AWG_LOGIN_RATE_LIMIT=10
# Дополнительные лимиты логина: по email без IP и по IP без email.
# Проверяются одновременно с парой IP+email; успешный вход сбрасывает только
# счётчик пары.
AWG_LOGIN_ACCOUNT_RATE_LIMIT=20
AWG_LOGIN_IP_RATE_LIMIT=30
AWG_LOGIN_RATE_WINDOW_SECS=300
AWG_REFRESH_RATE_LIMIT=60
AWG_REFRESH_RATE_WINDOW_SECS=300
AWG_REGISTER_RATE_LIMIT=5
AWG_REGISTER_RATE_WINDOW_SECS=300
AWG_RESEND_RATE_LIMIT=5
AWG_RESEND_RATE_WINDOW_SECS=300
AWG_FORGOT_RATE_LIMIT=5
AWG_FORGOT_RATE_WINDOW_SECS=300
# Лимит платёжных webhook по IP (публичный маршрут).
AWG_WEBHOOK_RATE_LIMIT=120
AWG_WEBHOOK_WINDOW_SECS=60

# Самостоятельная регистрация (POST /auth/register).
# false — регистрация отключена, ответ 403 registration_disabled; аккаунты
# создаёт администратор.
AWG_REGISTRATION_ENABLED=true

# WebSocket статистики: access-токен в query (?token=) выключен по умолчанию.
# true — совместимость со старым флоу; не рекомендуется, токен утекает в логи,
# прокси и историю браузера. Штатный флоу: POST /api/v1/ws/ticket → ?ticket=…
AWG_ALLOW_WS_TOKEN=false

# Сколько дней хранить журнал аудита (по умолчанию 90; <= 0 отключает очистку)
AWG_AUDIT_RETENTION_DAYS=90

# Почта для подтверждения email
# log — письмо пишется в лог; smtp — отправка через SMTP
AWG_MAIL_MODE=log
# только для smtp: smtp://user:pass@host:port
AWG_SMTP_URL=
# адрес отправителя, например panel@example.com
AWG_SMTP_FROM=
# Токен для GET/DELETE /api/v1/dev/mail в development/log-режиме.
# Пусто — принимается обычный admin access token. В production маршрут всегда 404.
AWG_DEV_MAIL_TOKEN=

# Биллинг (этап 1: каталог планов и чтение подписок/счетов)
# false — все /billing/* отвечают 404 billing_disabled
AWG_BILLING_ENABLED=false
AWG_BILLING_CURRENCY=RUB
# trial по умолчанию для будущих подписок (этап 1 только хранит значение)
AWG_BILLING_TRIAL_DAYS=0
# noop | mock | stripe | yookassa | cloudpayments | telegram_stars
# в production при AWG_BILLING_ENABLED=true noop и mock запрещены
AWG_PAYMENT_PROVIDER=noop
# секрет подписи webhook для mock-шлюза (>= 32 символов, только вне production)
AWG_PAYMENT_SECRET=

# Публичный URL admin gRPC для воркера
AWG_GRPC_URL=http://127.0.0.1:9090
# TLS для worker gRPC (по умолчанию plaintext h2c).
# Fail-closed: в production admin не стартует, если AWG_GRPC_BIND не loopback,
# а TLS не настроен. Plaintext на loopback разрешён с предупреждением.
# Admin: сертификат и ключ в PEM, задаются только вместе.
# AWG_GRPC_TLS_CERT=/etc/awg/tls/grpc.crt
# AWG_GRPC_TLS_KEY=/etc/awg/tls/grpc.key
# Admin mTLS: PEM CA, которым подписаны клиентские сертификаты воркеров.
# Если задан — сервер требует клиентский сертификат (только вместе с CERT/KEY).
# Допускается несколько CA в одном PEM-файле (ротация).
# AWG_GRPC_TLS_CLIENT_CA=/etc/awg/tls/worker-ca.crt
# Worker: доверенный CA и/или системные корни + имя из сертификата.
# AWG_GRPC_TLS_CA=/etc/awg/tls/grpc-ca.crt
# AWG_GRPC_TLS_DOMAIN=admin.internal
# AWG_GRPC_TLS_SYSTEM_ROOTS=false
# Worker mTLS: клиентский сертификат и ключ (PEM), только вместе и только при
# включённом TLS (CA/DOMAIN/SYSTEM_ROOTS). Сертификат должен быть подписан
# AWG_GRPC_TLS_CLIENT_CA на стороне admin.
# AWG_GRPC_TLS_CLIENT_CERT=/etc/awg/tls/worker.crt
# AWG_GRPC_TLS_CLIENT_KEY=/etc/awg/tls/worker.key

# Метрики Prometheus: GET /metrics
# Если задан — требуется Authorization: Bearer <token> (openssl rand -hex 24);
# без корректного токена — 401. В production при пустом токене /metrics
# отвечает 404 (эндпоинт скрыт), в development — открыт. Порт 8080 не
# публикуйте наружу.
AWG_METRICS_TOKEN=

# Формат логов: text | json
AWG_LOG_FORMAT=text
# Уровни через EnvFilter (info, debug, awg_admin=debug,tower_http=info)
RUST_LOG=info
# OTLP/gRPC endpoint (например http://127.0.0.1:4317); пусто — трейсинг выключен
AWG_OTEL_ENDPOINT=

# Плановая ротация backup redb (горячий снапшот без остановки admin)
# пусто — выключено; интервал в секундах (0 — выключить), AWG_BACKUP_KEEP — сколько файлов хранить
# Каталог backup создавайте с правами 0700, файлы — 0600 (см. docs/OPERATIONS.md).
AWG_BACKUP_DIR=
AWG_BACKUP_INTERVAL_SECS=86400
AWG_BACKUP_KEEP=7

# Таймауты и остановка
# таймаут обработки запроса /api в секундах (минимум 1, 504 JSON при истечении)
AWG_HTTP_TIMEOUT_SECS=30
# сколько секунд ждать завершения in-flight запросов после SIGTERM/SIGINT
# (минимум 1; должно быть меньше stop_grace_period в docker compose,
# по умолчанию stop_grace_period: 30s)
AWG_SHUTDOWN_GRACE_SECS=10

# Воркер
# docker-compose.yml передаёт worker только перечисленные ниже переменные
# (env_file для worker не используется, секреты admin ему недоступны).
AWG_NODE_ID=
AWG_NODE_TOKEN=
AWG_DRY_RUN=false
AWG_STATS_INTERVAL_SECS=2

# Traefik
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_CERT_RESOLVER=letsencrypt
# Образы в compose запинены по digest. Переопределяйте только вместе с digest,
# иначе потеряете воспроизводимость: TRAEFIK_IMAGE=traefik:v3.6@sha256:...
# TRAEFIK_IMAGE=traefik:v3.6
TRAEFIK_ACME_STORAGE=/letsencrypt/acme.json
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Адрес публикации frontend: 127.0.0.1 для локальной проверки, VPN-адрес для доступа через туннель
AWG_FRONTEND_BIND=127.0.0.1
# Адрес публикации HTTP (редирект на HTTPS) в профиле tls. 0.0.0.0 по умолчанию;
# 127.0.0.1 — если порт 80 занят или редирект снаружи не нужен.
AWG_TRAEFIK_HTTP_BIND=0.0.0.0
