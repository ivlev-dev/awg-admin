# Окружение: development | production
# в production обязательны AWG_MASTER_KEY, AWG_JWT_SECRET и непустой
# AWG_ADMIN_PASSWORD, отличный от admin12345
AWG_ENV=development

# Домен и TLS
AWG_DOMAIN=panel.localhost
TRAEFIK_ACME_EMAIL=

# Секреты
# openssl rand -base64 32
AWG_MASTER_KEY=
# openssl rand -base64 48; в production не короче 32 байт
AWG_JWT_SECRET=
# iss/aud JWT (по умолчанию awg-admin)
AWG_JWT_ISSUER=awg-admin
AWG_JWT_AUDIENCE=awg-admin

# Первичный администратор
AWG_ADMIN_LOGIN=admin
AWG_ADMIN_PASSWORD=admin12345

# Сеть/DNS
AWG_DNS=1.1.1.1,8.8.8.8
AWG_PUBLIC_URL=https://panel.localhost
AWG_CORS_ORIGINS=

# Rate limiting (in-memory sliding window)
# 0 отключает лимит; окно в секундах
AWG_LOGIN_RATE_LIMIT=10
AWG_LOGIN_RATE_WINDOW_SECS=300
AWG_REFRESH_RATE_LIMIT=60
AWG_REFRESH_RATE_WINDOW_SECS=300

# Публичный URL admin gRPC для воркера
AWG_GRPC_URL=http://127.0.0.1:9090

# Воркер
AWG_NODE_ID=
AWG_NODE_TOKEN=
AWG_DRY_RUN=false
AWG_STATS_INTERVAL_SECS=2

# Traefik
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_IMAGE=traefik:v3.6
TRAEFIK_ACME_STORAGE=/letsencrypt/acme.json
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
